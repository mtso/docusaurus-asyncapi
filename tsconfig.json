{
  // Shared compiler settings for the workspace packages.
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": ["node", "@docusaurus/module-type-aliases", "@docusaurus/theme-classic"],
    "baseUrl": ".",
    "noEmit": true
  },
  "exclude": ["node_modules", "example", "**/dist", "**/dist-jsx"]
}
